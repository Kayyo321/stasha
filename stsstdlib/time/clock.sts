mod clock;

lib "time" = ctime;

// ── Ticks ─────────────────────────────────────────────────────────────────
// Monotonic wall-clock ticks in nanoseconds.  Backed by a portable C shim
// (std/clock/clock_rt.c) that wraps clock_gettime(CLOCK_MONOTONIC) on POSIX,
// mach_absolute_time() on macOS, and QueryPerformanceCounter on Windows.

ext fn sts_clock_now_ns(void): i64;
ext fn sts_clock_ticks_per_sec(void): i64;

ext const i64 StsClockPerSec = 1000000000;

// Raw monotonic tick count (nanoseconds).
ext fn clock_ticks(void): i64 {
    ret sts_clock_now_ns();
}

// Convert ticks to milliseconds.
ext fn clock_ticks_to_ms(i64 ticks): f64 {
    ret (f64)ticks / 1000000.0;
}

// Convert ticks to microseconds.
ext fn clock_ticks_to_us(i64 ticks): f64 {
    ret (f64)ticks / 1000.0;
}

// ── Stopwatch ─────────────────────────────────────────────────────────────
// Measures monotonic wall-clock time between new() / reset() and elapsed_*().

ext type stopwatch_t: struct {
    int i64 t0;

    // Elapsed wall-clock time in milliseconds since construction or last reset().
    ext fn elapsed_ms(void): f64 {
        ret clock_ticks_to_ms(sts_clock_now_ns() - this.t0);
    }

    // Elapsed wall-clock time in microseconds since construction or last reset().
    ext fn elapsed_us(void): f64 {
        ret clock_ticks_to_us(sts_clock_now_ns() - this.t0);
    }

    // Return elapsed milliseconds and reset the timer.
    ext fn lap(void): f64 {
        final i64 now = sts_clock_now_ns();
        final f64 ms  = clock_ticks_to_ms(now - this.t0);
        this.t0 = now;
        ret ms;
    }

    // Restart the timer.
    ext fn reset(void): void {
        this.t0 = sts_clock_now_ns();
    }

    ext fn print(void): void {
        print.('stopwatch_t[elapsed_ms={}]\n', this.elapsed_ms());
    }
}

// Start a new stopwatch (captures the current tick count).
ext fn stopwatch_t.new(void): stopwatch_t {
    ret stopwatch_t{ .t0 = sts_clock_now_ns() };
}

// ── Calendar time ─────────────────────────────────────────────────────────

// Seconds since the Unix epoch (UTC).
ext fn clock_unix_time(void): i64 {
    ret ctime.time(0);
}

test 'clock_unix_time positive' {
    i64 t = clock_unix_time();
    expect.(t > 0);
}

test 'clock_ticks non-negative' {
    i64 t = clock_ticks();
    expect.(t >= 0);
}

test 'clock_ticks is monotonic' {
    i64 a = clock_ticks();
    i64 b = clock_ticks();
    expect.(b >= a);
}

test 'stopwatch elapsed non-negative' {
    stopwatch_t sw = stopwatch_t.new();
    f64 ms = sw.elapsed_ms();
    expect.(ms >= 0.0);
}

test 'stopwatch print does not crash' {
    stopwatch_t sw = stopwatch_t.new();
    sw.print();
    expect.(true);
}

test 'clock_ticks_to_ms conversion' {
    // 10 million ns = 10 ms
    f64 ms = clock_ticks_to_ms(10000000);
    expect.(ms > 9.0);
    expect.(ms < 11.0);
}
