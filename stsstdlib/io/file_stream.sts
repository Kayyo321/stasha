mod file_stream;

lib "stdio" = cio;

ext const i32 FsEndOfFile = -1;
ext const i32 FsWrite     = 1;
ext const i32 FsRead      = 2;
ext const i32 FsAppend    = 4;
ext const i32 FsAllFlags  = 7;

ext type file_stream_t: struct {
    int stack i8 *rw fp;   // FILE* stored as opaque pointer
    int i32 err_flag;

    // Returns bytes read, or 0 on error/EOF. Never exceed the caller's buffer.
    ext fn read(u32 no_bytes, stack i8 *w out_buf, u32 out_len): u32 {
        if (this.fp == nil || no_bytes > out_len || (out_buf == nil && no_bytes != 0)) {
            this.err_flag = 1;
            ret 0;
        }
        final u32 n = cio.fread(out_buf, 1, no_bytes, this.fp);
        if (cio.ferror(this.fp) != 0) {
            this.err_flag = 1;
        }
        ret n;
    }

    // Returns bytes written, or 0 on error.
    ext fn write(u32 no_bytes, stack i8 *r in_buf, u32 in_len): u32 {
        if (this.fp == nil || no_bytes > in_len || (in_buf == nil && no_bytes != 0)) {
            this.err_flag = 1;
            ret 0;
        }
        final u32 n = cio.fwrite(in_buf, 1, no_bytes, this.fp);
        if (cio.ferror(this.fp) != 0) {
            this.err_flag = 1;
        }
        ret n;
    }

    // Returns the next character as i32, or FsEndOfFile (-1) on EOF/error.
    ext fn get_ch(void): i32 {
        if (this.fp == nil) { this.err_flag = 1; ret FsEndOfFile; }
        ret cio.fgetc(this.fp);
    }

    // Push a character back into the stream so the next get_ch returns it.
    ext fn unget_ch(i32 ch): void {
        if (this.fp == nil) { this.err_flag = 1; ret; }
        cio.ungetc(ch, this.fp);
    }

    ext fn at_eof(void): bool {
        if (this.fp == nil) { ret true; }
        ret cio.feof(this.fp) != 0;
    }

    ext fn had_err(void): bool {
        ret this.err_flag != 0;
    }

    ext fn flush(void): void {
        if (this.fp == nil) { this.err_flag = 1; ret; }
        cio.fflush(this.fp);
    }

    ext fn is_open(void): bool {
        ret this.fp != nil;
    }

    ext fn print(void): void {
        print.('file_stream_t[open={}, err={}]\n',
               this.is_open(), this.had_err());
    }

    ext fn rem(void): void {
        if (this.fp != nil) {
            cio.fclose(this.fp);
            this.fp = nil;
        }
        this.err_flag = 0;
    }
}

// Build a fopen mode string from FsRead/FsWrite/FsAppend flags.
int fn build_mode_str(i32 mode, stack i8 *w out): void {
    i32 mi = 0;

    if (mode & FsAppend) {
        out[mi++] = `a`;
        if (mode & FsRead) { out[mi++] = `+`; }
    } else if ((mode & FsRead) && (mode & FsWrite)) {
        out[mi++] = `r`;
        out[mi++] = `+`;
    } else if (mode & FsWrite) {
        out[mi++] = `w`;
    } else {
        out[mi++] = `r`;
    }

    out[mi] = 0;
}

ext fn file_stream_t.new(stack i8 *r path, i32 mode): file_stream_t {
    i8 mode_str[4];
    build_mode_str(mode, mode_str);

    stack i8 *rw fp = cio.fopen(path, mode_str);
    ret file_stream_t{
        .fp       = fp,
        .err_flag = (fp != nil) ? 0 : 1
    };
}

// Tests write into the harness-owned working directory so parallel runs do
// not share fixed /tmp paths; failing artifacts remain available for review.

@[[if: os != "windows"]]
test 'file_stream open for write' {
    file_stream_t fs = file_stream_t.new("stasha_fs_test.txt", FsWrite);
    expect.(fs.is_open());
    expect.(!fs.had_err());
}
@[[if: os == "windows"]]
test 'file_stream open for write' {
    file_stream_t fs = file_stream_t.new("stasha_fs_test.txt", FsWrite);
    expect.(fs.is_open());
    expect.(!fs.had_err());
}

@[[if: os != "windows"]]
test 'file_stream write and read' {
    i8 msg[6];
    msg[0] = `h`; msg[1] = `e`; msg[2] = `l`; msg[3] = `l`; msg[4] = `o`; msg[5] = 0;

    file_stream_t fw = file_stream_t.new("stasha_fs_rw_test.txt", FsWrite);
    expect.(fw.is_open());
    u32 written = fw.write(5, msg, 6);
    expect_eq.(written, 5);
    fw.flush();

    file_stream_t fr = file_stream_t.new("stasha_fs_rw_test.txt", FsRead);
    expect.(fr.is_open());
    i8 buf[16];
    u32 n = fr.read(5, buf, 16);
    expect_eq.(n, 5);
    expect_eq.(buf[0], `h`);
    expect_eq.(buf[4], `o`);
}
@[[if: os == "windows"]]
test 'file_stream write and read' {
    i8 msg[6];
    msg[0] = `h`; msg[1] = `e`; msg[2] = `l`; msg[3] = `l`; msg[4] = `o`; msg[5] = 0;

    file_stream_t fw = file_stream_t.new("stasha_fs_rw_test.txt", FsWrite);
    expect.(fw.is_open());
    u32 written = fw.write(5, msg, 6);
    expect_eq.(written, 5);
    fw.flush();

    file_stream_t fr = file_stream_t.new("stasha_fs_rw_test.txt", FsRead);
    expect.(fr.is_open());
    i8 buf[16];
    u32 n = fr.read(5, buf, 16);
    expect_eq.(n, 5);
    expect_eq.(buf[0], `h`);
    expect_eq.(buf[4], `o`);
}

test 'file_stream open nonexistent for read fails' {
    file_stream_t fs = file_stream_t.new("stasha_no_such_file_xyz_98237.txt", FsRead);
    expect.(!fs.is_open());
}

@[[if: os != "windows"]]
test 'file_stream print open does not crash' {
    file_stream_t fs = file_stream_t.new("stasha_fs_print_test.txt", FsWrite);
    fs.print();
    expect.(true);
}
@[[if: os == "windows"]]
test 'file_stream print open does not crash' {
    file_stream_t fs = file_stream_t.new("stasha_fs_print_test.txt", FsWrite);
    fs.print();
    expect.(true);
}

test 'file_stream print closed does not crash' {
    file_stream_t fs = file_stream_t.new("stasha_no_such_xyz_98237.txt", FsRead);
    fs.print();
    expect.(true);
}

@[[if: os != "windows"]]
test 'file_stream get_ch' {
    i8 data[2];
    data[0] = 65; data[1] = 0;
    file_stream_t fw = file_stream_t.new("stasha_getch_test.txt", FsWrite);
    expect.(fw.is_open());
    fw.write(1, data, 2);
    fw.flush();

    file_stream_t fr = file_stream_t.new("stasha_getch_test.txt", FsRead);
    expect.(fr.is_open());
    i32 ch = fr.get_ch();
    expect_eq.(ch, 65);
}
@[[if: os == "windows"]]
test 'file_stream get_ch' {
    i8 data[2];
    data[0] = 65; data[1] = 0;
    file_stream_t fw = file_stream_t.new("stasha_getch_test.txt", FsWrite);
    expect.(fw.is_open());
    fw.write(1, data, 2);
    fw.flush();

    file_stream_t fr = file_stream_t.new("stasha_getch_test.txt", FsRead);
    expect.(fr.is_open());
    i32 ch = fr.get_ch();
    expect_eq.(ch, 65);
}

test 'file_stream mode strings use character bytes' {
    i8 mode[4] = .{};
    build_mode_str(FsWrite, mode);
    expect_eq.(mode[0], `w`);
    expect_eq.(mode[1], 0);
    build_mode_str(FsRead, mode);
    expect_eq.(mode[0], `r`);
    expect_eq.(mode[1], 0);
    build_mode_str(FsRead | FsWrite, mode);
    expect_eq.(mode[0], `r`);
    expect_eq.(mode[1], `+`);
    expect_eq.(mode[2], 0);
    build_mode_str(FsAppend | FsRead, mode);
    expect_eq.(mode[0], `a`);
    expect_eq.(mode[1], `+`);
    expect_eq.(mode[2], 0);
}

test 'file_stream closed operations return errors safely' {
    file_stream_t fs = file_stream_t{.fp = nil, .err_flag = 0};
    i8 buf[4] = .{};
    expect_eq.(fs.read(1, buf, 4), 0);
    expect.(fs.had_err());
    expect_eq.(fs.write(1, buf, 4), 0);
    expect_eq.(fs.get_ch(), FsEndOfFile);
    fs.unget_ch(65);
    fs.flush();
    expect.(fs.at_eof());
    fs.rem();
    fs.rem();
    expect.(!fs.is_open());
}

test 'file_stream rejects requests larger than the buffer' {
    file_stream_t fs = file_stream_t.new("stasha_fs_bounds_test.txt", FsWrite);
    expect.(fs.is_open());
    i8 buf[2] = .{65, 66};
    expect_eq.(fs.write(3, buf, 2), 0);
    expect.(fs.had_err());
    fs.rem();
    file_stream_t fr = file_stream_t.new("stasha_fs_bounds_test.txt", FsRead);
    expect.(fr.is_open());
    expect_eq.(fr.read(3, buf, 2), 0);
    expect.(fr.had_err());
    expect_eq.(buf[0], 65);
    expect_eq.(buf[1], 66);
}
