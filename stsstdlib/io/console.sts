mod console;

@[[if: os != "windows"]]
lib "unistd" = cunistd;

// On Windows, _write(fd, buf, count) mirrors POSIX write(2) and lives in
// the MSVC CRT (no extra import needed — it is exposed via the default
// msvcrt / ucrt link).
@[[if: os == "windows"]]
ext fn _write(i32 fd, i8 *r buf, u32 cnt): i32;

ext const i32 StdoutFD = 1;
ext const i32 StderrFD = 2;

ext type stdstream_t: enum {
    Stdout,
    Stderr,
}

ext macro log! {
    (...@args) => {
        @foreach arg : args {
            print.('{} ', arg);
        }
        print.('\n');
    }
}

ext macro elog! {
    (...@args) => {
        @foreach arg : args {
            print.error.('{} ', arg);
        }
        print.error.('\n');
    }
}

// Write cnt bytes from buf to the given file descriptor.
@[[if: os != "windows"]]
ext fn write_fd(i32 fd, i8 *r buf, u32 cnt): [i64, error] {
    final i64 write_result = cunistd.write(fd, buf, cnt);
    if write_result != (i64)cnt {
        ret write_result, error.('Expected to write {} bytes but wrote {}.', cnt, write_result);
    }
    ret write_result, nil;
}

@[[if: os == "windows"]]
ext fn write_fd(i32 fd, i8 *r buf, u32 cnt): [i64, error] {
    final i32 write_result = _write(fd, buf, cnt);
    if write_result < 0 {
        ret (i64)write_result, error.('write failed on fd {}', fd);
    }
    ret (i64)write_result, nil;
}

ext fn write_stream(stdstream_t stdstream, i8 *r buf, u32 cnt): [i64, error] {
    final i32 desc;
    match stdstream {
        stdstream_t.Stdout => { desc = StdoutFD; }
        stdstream_t.Stderr => { desc = StderrFD; }
    }

    ret write_fd(desc, buf, cnt);
}


test 'console empty standard stream writes succeed' {
    let [nout, eout] = write_stream(stdstream_t.Stdout, "", 0);
    expect_eq.(nout, 0);
    expect.(eout == nil);
    let [nerr, eerr] = write_stream(stdstream_t.Stderr, "", 0);
    expect_eq.(nerr, 0);
    expect.(eerr == nil);
}

@[[if: os != "windows"]]
test 'console write_fd reports invalid descriptors' {
    let [n, e] = write_fd(-1, "x", 1);
    expect_eq.(n, -1);
    expect.(e != nil);
}

@[[if: os != "windows"]]
test 'console write_fd preserves bytes and count' {
    i32 fds[2] = .{-1, -1};
    expect_eq.(cunistd.pipe(fds), 0);
    let [n, e] = write_fd(fds[1], "console", 7);
    expect_eq.(n, 7);
    expect.(e == nil);
    i8 data[8] = .{};
    final i64 got = cunistd.read(fds[0], data, 7);
    expect_eq.(got, 7);
    expect_eq.(data[0], `c`);
    expect_eq.(data[1], `o`);
    expect_eq.(data[2], `n`);
    expect_eq.(data[3], `s`);
    expect_eq.(data[4], `o`);
    expect_eq.(data[5], `l`);
    expect_eq.(data[6], `e`);
    expect_eq.(data[7], 0);
    expect_eq.(cunistd.close(fds[0]), 0);
    expect_eq.(cunistd.close(fds[1]), 0);
}
