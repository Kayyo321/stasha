mod mutex;

// Cross-platform mutex / rwlock / atomic_counter.
//   POSIX: pthread_mutex_t + pthread_rwlock_t.
//   Windows: CRITICAL_SECTION + SRWLOCK from kernel32.
//
// Public API is identical on both platforms. Sizes are intentionally
// over-allocated for cross-libc safety: pthread sizes vary between
// macOS, glibc, and musl; CRITICAL_SECTION is 40 bytes on x64.
//
// TODO: detect glibc/musl pthread sizes at compile time. Current POSIX
// sizes are the macOS-arm64 values and will over-allocate on Linux.

@[[if: os != "windows"]]
lib "pthread" = cpthread;

@[[if: os == "windows"]]
lib "kernel32" = ckernel32_mutex;
@[[if: os == "windows"]]
ext fn InitializeCriticalSection(stack void *w cs): void;
@[[if: os == "windows"]]
ext fn EnterCriticalSection(stack void *w cs): void;
@[[if: os == "windows"]]
ext fn LeaveCriticalSection(stack void *w cs): void;
@[[if: os == "windows"]]
ext fn TryEnterCriticalSection(stack void *w cs): i32;
@[[if: os == "windows"]]
ext fn DeleteCriticalSection(stack void *w cs): void;
@[[if: os == "windows"]]
ext fn InitializeSRWLock(stack void *w l): void;
@[[if: os == "windows"]]
ext fn AcquireSRWLockExclusive(stack void *w l): void;
@[[if: os == "windows"]]
ext fn ReleaseSRWLockExclusive(stack void *w l): void;
@[[if: os == "windows"]]
ext fn AcquireSRWLockShared(stack void *w l): void;
@[[if: os == "windows"]]
ext fn ReleaseSRWLockShared(stack void *w l): void;
@[[if: os == "windows"]]
ext fn TryAcquireSRWLockExclusive(stack void *w l): i8;
@[[if: os == "windows"]]
ext fn TryAcquireSRWLockShared(stack void *w l): i8;

// ── Platform sizes ────────────────────────────────────────────────────────
@[[if: os != "windows"]]
const u32 MutexSize  = 56;    // sizeof(pthread_mutex_t)  on macOS arm64
@[[if: os != "windows"]]
const u32 RwlockSize = 192;   // sizeof(pthread_rwlock_t) on macOS arm64
@[[if: os == "windows"]]
const u32 MutexSize  = 40;    // sizeof(CRITICAL_SECTION) on x64
@[[if: os == "windows"]]
const u32 RwlockSize = 8;     // sizeof(SRWLOCK)          on x64

// ── mutex_t ────────────────────────────────────────────────────────────────

@[[if: os != "windows"]]
ext type mutex_t: struct {
    int heap u8 *rw handle;
    int bool initialized;

    ext fn lock(void): void {
        cpthread.pthread_mutex_lock(this.handle);
    }
    ext fn unlock(void): void {
        cpthread.pthread_mutex_unlock(this.handle);
    }
    ext fn try_lock(void): bool {
        ret cpthread.pthread_mutex_trylock(this.handle) == 0;
    }
    ext fn print(void): void {
        print.('mutex_t[initialized={}]\n', this.initialized);
    }
    ext fn rem(void): void {
        if (this.initialized) {
            cpthread.pthread_mutex_destroy(this.handle);
            rem.(this.handle);
            this.initialized = false;
            this.handle = nil;
        }
    }
}

@[[if: os != "windows"]]
ext fn mutex_t.new(void): mutex_t {
    heap u8 *rw h = new.(MutexSize);
    cpthread.pthread_mutex_init(h, nil);
    ret mutex_t{
        .handle = h,
        .initialized = true
    };
}

@[[if: os == "windows"]]
ext type mutex_t: struct {
    int heap u8 *rw handle;
    int bool initialized;

    ext fn lock(void): void {
        EnterCriticalSection(this.handle);
    }
    ext fn unlock(void): void {
        LeaveCriticalSection(this.handle);
    }
    ext fn try_lock(void): bool {
        ret TryEnterCriticalSection(this.handle) != 0;
    }
    ext fn print(void): void {
        print.('mutex_t[initialized={}]\n', this.initialized);
    }
    ext fn rem(void): void {
        if (this.initialized) {
            DeleteCriticalSection(this.handle);
            rem.(this.handle);
            this.initialized = false;
            this.handle = nil;
        }
    }
}

@[[if: os == "windows"]]
ext fn mutex_t.new(void): mutex_t {
    heap u8 *rw h = new.(MutexSize);
    InitializeCriticalSection(h);
    ret mutex_t{
        .handle = h,
        .initialized = true
    };
}

// ── rwlock_t ───────────────────────────────────────────────────────────────

@[[if: os != "windows"]]
ext type rwlock_t: struct {
    int heap u8 *rw handle;
    int bool initialized;

    ext fn read_lock(void): void {
        cpthread.pthread_rwlock_rdlock(this.handle);
    }
    ext fn write_lock(void): void {
        cpthread.pthread_rwlock_wrlock(this.handle);
    }
    ext fn read_unlock(void): void {
        cpthread.pthread_rwlock_unlock(this.handle);
    }
    ext fn write_unlock(void): void {
        cpthread.pthread_rwlock_unlock(this.handle);
    }
    ext fn try_read_lock(void): bool {
        ret cpthread.pthread_rwlock_tryrdlock(this.handle) == 0;
    }
    ext fn try_write_lock(void): bool {
        ret cpthread.pthread_rwlock_trywrlock(this.handle) == 0;
    }
    ext fn print(void): void {
        print.('rwlock_t[initialized={}]\n', this.initialized);
    }
    ext fn rem(void): void {
        if (this.initialized) {
            cpthread.pthread_rwlock_destroy(this.handle);
            rem.(this.handle);
            this.initialized = false;
            this.handle = nil;
        }
    }
}

@[[if: os != "windows"]]
ext fn rwlock_t.new(void): rwlock_t {
    heap u8 *rw h = new.(RwlockSize);
    cpthread.pthread_rwlock_init(h, nil);
    ret rwlock_t{
        .handle = h,
        .initialized = true
    };
}

@[[if: os == "windows"]]
ext type rwlock_t: struct {
    int heap u8 *rw handle;
    int bool initialized;

    ext fn read_lock(void): void {
        AcquireSRWLockShared(this.handle);
    }
    ext fn write_lock(void): void {
        AcquireSRWLockExclusive(this.handle);
    }
    ext fn read_unlock(void): void {
        ReleaseSRWLockShared(this.handle);
    }
    ext fn write_unlock(void): void {
        ReleaseSRWLockExclusive(this.handle);
    }
    ext fn try_read_lock(void): bool {
        ret TryAcquireSRWLockShared(this.handle) != 0;
    }
    ext fn try_write_lock(void): bool {
        ret TryAcquireSRWLockExclusive(this.handle) != 0;
    }
    ext fn print(void): void {
        print.('rwlock_t[initialized={}]\n', this.initialized);
    }
    ext fn rem(void): void {
        // SRWLOCK has no destroy step; just release ownership.
        if (this.initialized) {
            rem.(this.handle);
            this.initialized = false;
            this.handle = nil;
        }
    }
}

@[[if: os == "windows"]]
ext fn rwlock_t.new(void): rwlock_t {
    heap u8 *rw h = new.(RwlockSize);
    InitializeSRWLock(h);
    ret rwlock_t{
        .handle = h,
        .initialized = true
    };
}

// ── atomic_counter_t ───────────────────────────────────────────────────────

@[[if: os != "windows"]]
ext type atomic_counter_t: struct {
    int heap u8 *rw mutex_handle;
    int i64 value;

    ext fn increment(void): i64 {
        cpthread.pthread_mutex_lock(this.mutex_handle);
        this.value = this.value + 1;
        i64 v = this.value;
        cpthread.pthread_mutex_unlock(this.mutex_handle);
        ret v;
    }
    ext fn decrement(void): i64 {
        cpthread.pthread_mutex_lock(this.mutex_handle);
        this.value = this.value - 1;
        i64 v = this.value;
        cpthread.pthread_mutex_unlock(this.mutex_handle);
        ret v;
    }
    ext fn add(i64 n): i64 {
        cpthread.pthread_mutex_lock(this.mutex_handle);
        this.value = this.value + n;
        i64 v = this.value;
        cpthread.pthread_mutex_unlock(this.mutex_handle);
        ret v;
    }
    ext fn get(void): i64 {
        cpthread.pthread_mutex_lock(this.mutex_handle);
        i64 v = this.value;
        cpthread.pthread_mutex_unlock(this.mutex_handle);
        ret v;
    }
    ext fn set(i64 n): void {
        cpthread.pthread_mutex_lock(this.mutex_handle);
        this.value = n;
        cpthread.pthread_mutex_unlock(this.mutex_handle);
    }
    ext fn print(void): void {
        print.('atomic_counter_t[value={}]\n', this.get());
    }
    ext fn rem(void): void {
        cpthread.pthread_mutex_destroy(this.mutex_handle);
        rem.(this.mutex_handle);
        this.mutex_handle = nil;
        this.value = 0;
    }
}

@[[if: os != "windows"]]
ext fn atomic_counter_t.new(i64 initial): atomic_counter_t {
    heap u8 *rw h = new.(MutexSize);
    cpthread.pthread_mutex_init(h, nil);
    ret atomic_counter_t{
        .mutex_handle = h,
        .value = initial
    };
}

@[[if: os == "windows"]]
ext type atomic_counter_t: struct {
    int heap u8 *rw mutex_handle;
    int i64 value;

    ext fn increment(void): i64 {
        EnterCriticalSection(this.mutex_handle);
        this.value = this.value + 1;
        i64 v = this.value;
        LeaveCriticalSection(this.mutex_handle);
        ret v;
    }
    ext fn decrement(void): i64 {
        EnterCriticalSection(this.mutex_handle);
        this.value = this.value - 1;
        i64 v = this.value;
        LeaveCriticalSection(this.mutex_handle);
        ret v;
    }
    ext fn add(i64 n): i64 {
        EnterCriticalSection(this.mutex_handle);
        this.value = this.value + n;
        i64 v = this.value;
        LeaveCriticalSection(this.mutex_handle);
        ret v;
    }
    ext fn get(void): i64 {
        EnterCriticalSection(this.mutex_handle);
        i64 v = this.value;
        LeaveCriticalSection(this.mutex_handle);
        ret v;
    }
    ext fn set(i64 n): void {
        EnterCriticalSection(this.mutex_handle);
        this.value = n;
        LeaveCriticalSection(this.mutex_handle);
    }
    ext fn print(void): void {
        print.('atomic_counter_t[value={}]\n', this.get());
    }
    ext fn rem(void): void {
        DeleteCriticalSection(this.mutex_handle);
        rem.(this.mutex_handle);
        this.mutex_handle = nil;
        this.value = 0;
    }
}

@[[if: os == "windows"]]
ext fn atomic_counter_t.new(i64 initial): atomic_counter_t {
    heap u8 *rw h = new.(MutexSize);
    InitializeCriticalSection(h);
    ret atomic_counter_t{
        .mutex_handle = h,
        .value = initial
    };
}

// ── Tests ──────────────────────────────────────────────────────────────────

test 'mutex create and destroy' {
    mutex_t m = mutex_t.new();
    expect.(m.initialized);
    mutex_t.rem();
    expect.(m.initialized == false);
}

test 'mutex lock and unlock' {
    mutex_t m = mutex_t.new();
    m.lock();
    m.unlock();
    expect.(true);
    mutex_t.rem();
}

test 'mutex try_lock when unlocked returns true' {
    mutex_t m = mutex_t.new();
    bool got = m.try_lock();
    expect.(got);
    m.unlock();
    mutex_t.rem();
}

test 'rwlock create and destroy' {
    rwlock_t rw = rwlock_t.new();
    expect.(rw.initialized);
    rwlock_t.rem();
    expect.(rw.initialized == false);
}

test 'rwlock read lock and unlock' {
    rwlock_t rw = rwlock_t.new();
    rw.read_lock();
    rw.read_unlock();
    expect.(true);
    rwlock_t.rem();
}

test 'rwlock write lock and unlock' {
    rwlock_t rw = rwlock_t.new();
    rw.write_lock();
    rw.write_unlock();
    expect.(true);
    rwlock_t.rem();
}

test 'atomic_counter increment and decrement' {
    atomic_counter_t c = atomic_counter_t.new(0);
    i64 v1 = c.increment();
    expect_eq.(v1, 1);
    i64 v2 = c.increment();
    expect_eq.(v2, 2);
    i64 v3 = c.decrement();
    expect_eq.(v3, 1);
    atomic_counter_t.rem();
}

test 'atomic_counter add and get' {
    atomic_counter_t c = atomic_counter_t.new(10);
    i64 v = c.add((i64)5);
    expect_eq.(v, 15);
    i64 g = c.get();
    expect_eq.(g, 15);
    atomic_counter_t.rem();
}

test 'atomic_counter set' {
    atomic_counter_t c = atomic_counter_t.new(0);
    c.set((i64)42);
    i64 v = c.get();
    expect_eq.(v, 42);
    atomic_counter_t.rem();
}

test 'atomic_counter initial value' {
    atomic_counter_t c = atomic_counter_t.new(100);
    i64 v = c.get();
    expect_eq.(v, 100);
    atomic_counter_t.rem();
}

test 'mutex print does not crash' {
    mutex_t m = mutex_t.new();
    m.print();
    mutex_t.rem();
    expect.(true);
}

test 'rwlock print does not crash' {
    rwlock_t rw = rwlock_t.new();
    rw.print();
    rwlock_t.rem();
    expect.(true);
}

test 'atomic_counter print does not crash' {
    atomic_counter_t c = atomic_counter_t.new(42);
    c.print();
    atomic_counter_t.rem();
    expect.(true);
}
