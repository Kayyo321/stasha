mod regex;

// Regex is provided by a bundled, dependency-free C engine
// (std/regex/regex_rt.c) so this module links identically on macOS,
// Linux and Windows — no POSIX <regex.h> needed.

ext const i32 RegExtended = 1;   // accepted for source compatibility; ignored
ext const i32 RegIcase    = 2;   // not yet implemented
ext const i32 RegNewline  = 4;   // not yet implemented
ext const i32 RegNomatch  = 1;

ext fn sts_regex_compile(stack u8 *w+ ctx, stack i8 *r+ pattern, i32 flags): i32;
ext fn sts_regex_test(stack u8 *r+ ctx, stack i8 *r+ text): i32;
ext fn sts_regex_exec(stack u8 *r+ ctx, stack i8 *r+ text,
                      stack i32 *w out_start, stack i32 *w out_end): i32;

// The compiled context is ~9 KB; over-allocate 16 KB to stay safe even if
// the engine's bookkeeping grows.  We don't ask the C side at runtime
// because the .sts language has no way to import a C size_t constant.
ext const u32 RegexCtxSize = 16384;

ext type regex_pat_t: struct {
    ext heap u8 *rw handle;
    ext bool compiled;

    ext fn compile(stack i8 *r+ pattern, i32 flags): error {
        i32 rc = sts_regex_compile(this.handle, pattern, flags);
        if (rc != 0) {
            ret error.('regex compile failed');
        }
        this.compiled = true;
        ret nil;
    }

    // Returns true if pattern matches anywhere in str.
    ext fn test_str(stack i8 *r+ str): bool {
        i32 rc = sts_regex_test(this.handle, str);
        ret rc != 0;
    }

    // Returns true if match found; stores start/end byte offsets in match_start/match_end.
    ext fn exec_at(stack i8 *r+ str, stack i32 *w match_start, stack i32 *w match_end): bool {
        i32 rc = sts_regex_exec(this.handle, str, match_start, match_end);
        ret rc != 0;
    }

    ext fn print(void): void {
        print.('regex_pat_t[compiled={}]\n', this.compiled);
    }

    ext fn rem(void): void {
        if (this.handle != nil) {
            rem.(this.handle);
            this.handle = nil;
        }
        this.compiled = false;
    }
}

ext fn regex_pat_t.new(void): regex_pat_t {
    heap u8 *rw h = new.(RegexCtxSize);
    for (u32 i = 0; i < RegexCtxSize; i++) { h[i] = 0; }
    ret regex_pat_t{
        .handle   = h,
        .compiled = false
    };
}

// Compile and test in one shot.
ext fn regex_match(stack i8 *r+ pattern, stack i8 *r+ str): bool {
    regex_pat_t pat = regex_pat_t.new();
    error e = pat.compile(pattern, 0);
    if (e != nil) {
        pat.rem();
        ret false;
    }
    bool result = pat.test_str(str);
    pat.rem();
    ret result;
}

// Alias kept for source compatibility — the engine has no separate
// "extended" mode (it always accepts the documented subset).
ext fn regex_match_extended(stack i8 *r+ pattern, stack i8 *r+ str): bool {
    ret regex_match(pattern, str);
}

// ── Tests ────────────────────────────────────────────────────────────────────

test 'compile and match basic' {
    regex_pat_t pat = regex_pat_t.new();
    error e = pat.compile("hello", 0);
    expect.(e == nil);
    expect.(pat.compiled);
    expect.(pat.test_str("say hello world"));
    expect.(!pat.test_str("no match here"));
    pat.rem();
}

test 'match extended pattern' {
    regex_pat_t pat = regex_pat_t.new();
    error e = pat.compile("[0-9]+", 1);
    expect.(e == nil);
    expect.(pat.test_str("abc123def"));
    expect.(!pat.test_str("no digits here"));
    pat.rem();
}

test 'regex_match free function' {
    expect.(regex_match("hello", "say hello world"));
    expect.(!regex_match("xyz", "abc def"));
}

test 'regex_match_extended' {
    expect.(regex_match_extended("[0-9]+", "abc 42 def"));
    expect.(!regex_match_extended("[0-9]+", "no digits"));
}

test 'regex_pat print compiled' {
    regex_pat_t pat = regex_pat_t.new();
    pat.compile("hello", 0);
    pat.print();
    pat.rem();
    expect.(true);
}

test 'regex_pat print uncompiled' {
    regex_pat_t pat = regex_pat_t.new();
    pat.print();
    pat.rem();
    expect.(true);
}

test 'exec_at offset' {
    regex_pat_t pat = regex_pat_t.new();
    error e = pat.compile("lo", 0);
    expect.(e == nil);
    i32 ms = 0;
    i32 me = 0;
    stack i32 *rw msp = &ms;
    stack i32 *rw mep = &me;
    bool found = pat.exec_at("hello world", msp, mep);
    expect.(found);
    expect_eq.(ms, 3);
    expect_eq.(me, 5);
    pat.rem();
}

test 'anchored start' {
    regex_pat_t pat = regex_pat_t.new();
    error e = pat.compile("^hello", 0);
    expect.(e == nil);
    expect.(pat.test_str("hello world"));
    expect.(!pat.test_str("say hello"));
    pat.rem();
}

test 'anchored end' {
    regex_pat_t pat = regex_pat_t.new();
    error e = pat.compile("world$", 0);
    expect.(e == nil);
    expect.(pat.test_str("hello world"));
    expect.(!pat.test_str("world cup"));
    pat.rem();
}

test 'quantifier optional' {
    regex_pat_t pat = regex_pat_t.new();
    error e = pat.compile("colou?r", 0);
    expect.(e == nil);
    expect.(pat.test_str("the color red"));
    expect.(pat.test_str("the colour red"));
    pat.rem();
}
