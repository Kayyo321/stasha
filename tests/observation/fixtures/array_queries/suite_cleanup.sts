mod observation_array_query_cleanup;
heap u8 *rw held = nil;
stack i32 calls = 0;
fn index(void): i32 {
    held = new.(13);
    expect.(held != nil);
    calls += 1;
    ret 0;
}
fn measure(void): void {
    stack i32 rows[2][3] = .{};
    expect_eq.(len.(rows[index()]), 3);
    expect_eq.(calls, 1);
}
test 'allocate through query and once' {
    print.('OBSERVATION_ONCE\n');
    measure();
}
test 'release after earlier test' {
    rem.(held);
}
