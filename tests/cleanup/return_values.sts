mod cleanup_return_values;


fn read_value(stack i32 value): i32 {
    print.('call {}\n', value);
    ret value;
}

fn scalar(void): i32 {
    stack i32 value = 7;
    defer { value = 99; print.('scalar.defer {}\n', value); }
    ret read_value(value);
}

fn pair(void): [i32, i32] {
    stack i32 left = 11;
    stack i32 right = 22;
    defer {
        left = 101;
        right = 202;
        print.('pair.defer {} {}\n', left, right);
    }
    ret read_value(left), read_value(right);
}

fn main(void): i32 {
    stack i32 value = scalar();
    print.('scalar.result {}\n', value);
    stack i32 [left, right] = pair();
    print.('pair.result {} {}\n', left, right);
    if (value != 7 || left != 11 || right != 22) { ret 1; }
    print.('return_values: ok\n');
    ret 0;
}
