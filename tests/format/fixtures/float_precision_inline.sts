mod float_precision_inline;
fn classic32(stack f32 value): void {
    print.('classic32={:.0}|{:.2}|{:.4}|{:8.2}|{:08.2}|{:+08.2}|{:<+08.2}|{:#.0}\n', value,value,value,value,value,value,value,value);
}
fn inline64(stack f64 value): void {
    print.(@'inline64={value:.0}|{value:.2}|{value:.4}|{value:8.2}|{value:08.2}|{value:+08.2}|{value:<+08.2}|{value:#.0}\n');
}
// Kept uncalled: exact O0 IR covers stderr sink and global/promotion ordering.
fn stderr_controls(stack f32 small, stack f64 large): void {
    print.error.('stderr32={:+08.2}|{:<+08.2}\n', small, small);
    print.error.(@'stderr64={large:.4}|{large:#.0}\n');
}
fn main(void): i32 {
    stack f32 small = 3.125; stack f64 large = 3.125;
    classic32(small); inline64(large);
    print.('defaults={}|{}|{:8}|{:+}|{:<8}\n', small,large,large,large,large);
    print.('integer={:.2}|{:08x}|{}\n', 42,255,42);
    print.('ties={:.0}|{:.0}|{:.1}|{:.0}\n', 2.5,3.5,1.25,9.5);
    print.('literal=\{raw\} % \\\n');
    ret 0;
}
